HOST=127.0.0.1
PORT=4173
EXPORT_DIR=./var/exports
PREVIEW_DIR=./var/previews
MAX_EXPORT_REQUEST_BYTES=2097152
EXPORT_IMAGE_HOSTS=
EXPORT_CHROMIUM_PATH=
EXPORT_CHROMIUM_NO_SANDBOX=false

# —— Docker Compose 依赖服务凭据（compose.yaml 启动前必须设置；生产用强随机口令）——
POSTGRES_USER=resume
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
REDIS_PASSWORD=
REDIS_PORT=6379

# —— 应用直连（仅宿主进程模式 start.bat 使用；口令须与上方一致）——
DATABASE_URL=postgres://resume:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:55432/resume_editor
TEMPLATE_STORAGE_DIR=./var/templates
PYTHON_BIN=python
SOFFICE_BIN=soffice
PDFTOPPM_BIN=pdftoppm
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:6379
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# 账户与会话（生产环境必须设置）
# 会话有效期（天），默认 30
SESSION_TTL_DAYS=30
# 设为 true 关闭公开注册（仅保留已存在账号，适合邀请制上线）
DISABLE_REGISTRATION=false
# 追加禁用的一次性邮箱域名（逗号分隔）；内置常见临时邮箱域名已默认拦截
BLOCKED_EMAIL_DOMAINS=
# 部署在反向代理（nginx/Caddy）之后时设为 true，以便从 X-Forwarded-For 取真实客户端 IP
TRUST_PROXY=false
# 设为 true 关闭设备指纹采集与同人多账号检测（仅关闭标记/告警，不影响登录鉴权）
DISABLE_DEVICE_FINGERPRINT=false
# 仅在 HTTPS 反向代理后强制会话 Cookie 携带 Secure 标记
COOKIE_SECURE=false
# 管理员邮箱，逗号分隔；注册或登录时命中即自动授予管理员权限
ADMIN_EMAILS=admin@example.com
# 管理员手机号（可选），逗号分隔
ADMIN_PHONES=
# 测试账号种子：仅开发/测试置为 true；生产务必关闭。口令不再提供弱默认值，启用时必须显式设置。
SEED_TEST_USERS=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=

# AI 简历生成（DeepSeek；生产环境必须设置 AI_CONFIG_ENC_KEY）
# 主密钥：32 字节，hex(64 字符) 或 base64 均可，用于 AES-256-GCM 加密落库的 API Key。
# 只通过密钥系统/环境变量注入，绝不写进代码或数据库；缺失时 AI 功能整体降级为不可用。
# 本地开发：start.bat / start_dev.bat 会自动生成并复用 var/.ai-enc-key，无需手动设置。
AI_CONFIG_ENC_KEY=
# 每用户每日 AI 生成次数上限（默认 8）
AI_USER_DAILY_LIMIT=8
# 单 IP 每日 AI 生成次数上限（默认 24；用于抑制同人多账号放大配额）
AI_IP_DAILY_LIMIT=24
# 服务端调用模型的并发上限（默认 2）
AI_MAX_CONCURRENCY=2
# 单次输入最大字符数（默认 8000；管理端可在 DB 覆盖）
AI_INPUT_MAX_CHARS=8000
# 单次输出最大 token（默认 1600；管理端可在 DB 覆盖）
AI_OUTPUT_MAX_TOKENS=1600
# 调用超时毫秒（默认 30000；管理端可在 DB 覆盖）
AI_TIMEOUT_MS=30000

# 告警巡检（可选）：后台定时检查 AI 失败/队列积压，记录到 alert_log 并可触发 webhook。
# webhook 会收到告警 JSON（POST），可接 Slack/Discord/钉钉/企业微信等机器人。
ALERT_WEBHOOK_URL=
# 巡检间隔毫秒（默认 60000，最小 10000）
ALERT_CHECK_INTERVAL_MS=60000
# 近 N 分钟内 AI 失败(provider_error/timeout)次数达到阈值触发告警（默认 30 分钟 / 5 次）
ALERT_AI_FAILURE_WINDOW_MIN=30
ALERT_AI_FAILURE_THRESHOLD=5
# 导出/预览队列失败任务数达到阈值触发告警（默认 10）
ALERT_QUEUE_FAILED_THRESHOLD=10
